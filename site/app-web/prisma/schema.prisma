// Nasce do formulário "Proposta de Compra e Venda" no portal do corretor
// (app/portal/proposta/novo) — diferente da Gestão, o imóvel aqui NUNCA é
// cadastrado de verdade (rua/numero/complemento/bairro/cidade/estado ficam
// só em texto, direto nesta linha): a proposta normalmente é sobre um imóvel
// externo, sem proprietário na base. cliente_id é sempre reaproveitado ou
// criado do mesmo jeito que em Gestões (nunca editado por aqui). forma_pagamento
// já vem pronta em texto (várias condições, uma por linha), montada no
// formulário a partir de linhas tipo/valor/forma/parcelas/momento/data — não
// existe uma tabela própria de condições porque a proposta não é uma
// transação de verdade.
model propostas {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parceiro_id       String    @db.Uuid
  cliente_id        String    @db.Uuid
  descricao         String?
  rua               String?
  numero            String?
  complemento       String?
  bairro            String?
  cidade            String?
  estado            String?
  valor_proposta    Decimal   @db.Decimal(14, 2)
  forma_pagamento   String?
  data_fechamento   DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  parceiros         parceiros @relation(fields: [parceiro_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clientes          clientes  @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([parceiro_id], map: "idx_propostas_parceiro")
  @@index([cliente_id], map: "idx_propostas_cliente")
}

/// Notícias e editais gerenciados em Configurações. Aparecem na página
/// pública (fora do login) e, quando portal_corretor = true, também no
/// mural do Portal do Corretor. Substituiu a tabela "noticias" antiga
/// (mantida no schema só por compatibilidade, sem tela própria e sem uso).
model publicacoes_site {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo              String     @default("Noticia")
  titulo            String
  resumo            String?
  corpo             String
  imagem_url        String?
  ativo             Boolean    @default(true)
  // Controla se a publicação também aparece no mural de Notícias do Portal
  // do Corretor (app/portal/page.tsx), além do mural público em /login. A
  // tabela "noticias" citada no comentário acima nunca teve tela de
  // cadastro própria (só dava pra popular direto no banco) — foi
  // substituída por esse campo, unificando tudo numa publicação só.
  portal_corretor   Boolean    @default(false)
  publicado_em      DateTime   @default(now()) @db.Timestamptz(6)
  autor_parceiro_id String?    @db.Uuid
  created_at        DateTime   @default(now()) @db.Timestamptz(6)
  updated_at        DateTime   @default(now()) @db.Timestamptz(6)
  parceiros         parceiros? @relation(fields: [autor_parceiro_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([ativo, publicado_em], map: "idx_publicacoes_site_ativo")
  @@index([portal_corretor, ativo, publicado_em], map: "idx_publicacoes_site_portal")
}

/// Sócios da imobiliária em destaque no dashboard externo (/login), logo
/// abaixo do Ranking de honorários — pedido do usuário 29/08/2026. Reaproveita
/// foto e nome de um Parceiro já cadastrado (não tem foto própria: o admin só
/// escolhe o parceiro numa lista e digita a função dentro da imobiliária, ex.
/// "Sócio-diretor") — @unique em parceiro_id porque cada parceiro só pode
/// aparecer uma vez na lista de sócios. Mostra no máximo 3 no site, na ordem
/// de cadastro (criado_em) — sem tela de reordenar por enquanto: pra mudar a
/// ordem, remove e cadastra de novo na ordem desejada.
model socios_dashboard {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parceiro_id String    @unique @db.Uuid
  funcao      String
  criado_em   DateTime  @default(now()) @db.Timestamptz(6)
  parceiros   parceiros @relation(fields: [parceiro_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// Controla quais notificações do sino (admin e Portal do Corretor) cada
/// parceiro já dispensou (fechou e não quer ver de novo) — pedido do usuário
/// 30/08/2026. notificacao_id é o mesmo id determinístico já usado em
/// lib/notificacoes.ts (ex.: "sac-<id>", "evento-<id>-<data>") — não existe
/// FK pra uma entidade só porque o id muda de formato conforme a categoria.
/// Dispensar não apaga nem resolve nada na origem: só esconde aquele item
/// específico do sino daquele parceiro; se a mesma condição gerar um id novo
/// (ex.: evento recorrente no dia seguinte), volta a aparecer normalmente.
model notificacoes_dispensadas {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parceiro_id    String    @db.Uuid
  notificacao_id String
  dispensada_em  DateTime  @default(now()) @db.Timestamptz(6)
  parceiros      parceiros @relation(fields: [parceiro_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([parceiro_id, notificacao_id])
  @@index([parceiro_id])
}

/// Mensagens do formulário de SAC da página pública — não envia e-mail
/// automático por enquanto, fica como uma fila que o admin abre e resolve
/// manualmente em Configurações.
model mensagens_sac {
  id                        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                      String
  email                     String
  telefone                  String?
  assunto                   String?
  mensagem                  String
  status                    String     @default("Novo")
  resolvido_por_parceiro_id String?    @db.Uuid
  resolvido_em              DateTime?  @db.Timestamptz(6)
  criado_em                 DateTime   @default(now()) @db.Timestamptz(6)
  parceiros                 parceiros? @relation(fields: [resolvido_por_parceiro_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, criado_em], map: "idx_mensagens_sac_status")
}

model recibos_locacao {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_legado        String?    @unique
  tipo             String?
  transacao_id     String     @db.Uuid
  desconto         Decimal?   @db.Decimal(14, 2)
  valor_descontado Decimal?   @db.Decimal(14, 2)
  observacao       String?
  arquivo_url      String?
  created_at       DateTime   @default(now()) @db.Timestamptz(6)
  transacoes       transacoes @relation(fields: [transacao_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([transacao_id], map: "idx_recibos_locacao_transacao")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
