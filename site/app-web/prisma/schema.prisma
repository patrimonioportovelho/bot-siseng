// Perfil de marca pessoal do corretor (Fase 5b, 09/08/2026) — Notion
// "Corretores". 1 registro por Parceiro, vínculo opcional (nem todo
// corretor precisa ter perfil preenchido) — por isso parceiro_id é @unique
// em vez de ser a própria chave primária.
model marketing_corretores {
  id                                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parceiro_id                        String     @unique @db.Uuid
  instagram                          String?
  tom_voz                            String?
  posicionamento                     String?
  pilares_conteudo                   String?
  publico_prioritario                String?
  regiao                             String?
  especialidade                      String?
  meta_mensal_leads                  Int?
  responsavel_marketing_parceiro_id  String?    @db.Uuid
  status                             String     @default("Ativo")
  created_at                         DateTime   @default(now()) @db.Timestamptz(6)
  updated_at                         DateTime   @default(now()) @db.Timestamptz(6)
  parceiros_marketing_corretores_parceiro_idToparceiros           parceiros  @relation("marketing_corretores_parceiro_idToparceiros", fields: [parceiro_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parceiros_marketing_corretores_responsavel_marketing_idToparceiros parceiros? @relation("marketing_corretores_responsavel_marketing_idToparceiros", fields: [responsavel_marketing_parceiro_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// Pipeline peça a peça dentro de UMA Ordem (Fase 5c, 09/08/2026) — Notion
// "Produção". 1 Ordem pode virar várias peças (1 vídeo + 3 stories + 1
// carrossel, por exemplo), cada uma com seu próprio prazo/arquivo/revisões.
model marketing_producoes {
  id                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  marketing_ordem_id       String            @db.Uuid
  peca                     String
  roteiro                  String?
  arquivos_brutos_url      String?
  versao_aprovacao_url     String?
  arquivo_final_url        String?
  revisoes                 Int               @default(0)
  responsavel_parceiro_id  String?           @db.Uuid
  prazo_entrega            DateTime?         @db.Date
  data_captacao            DateTime?         @db.Date
  local                    String?
  referencia               String?
  status                   String            @default("Pendente")
  excluido                 Boolean           @default(false)
  created_at               DateTime          @default(now()) @db.Timestamptz(6)
  updated_at               DateTime          @default(now()) @db.Timestamptz(6)
  marketing_ordens         marketing_ordens  @relation(fields: [marketing_ordem_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parceiros                parceiros?        @relation(fields: [responsavel_parceiro_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model marketing_atividades {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  marketing_ordem_id String           @db.Uuid
  tipo               String
  titulo             String
  data               DateTime         @db.Date
  // Horário avulso "HH:MM" (Fase Marketing/Agenda — cancelamento e
  // reagendamento, 16/08/2026) — `data` é @db.Date, sem componente de hora
  // nenhum, e é essa tabela que alimenta tanto a ficha da OM quanto o
  // calendário compartilhado (/manutencao/calendario). Pedido do usuário:
  // "preciso do horario nas atividades do OM e preciso que ele acompanhe no
  // calendario geral também". Texto simples (não Time do banco) pra não
  // precisar de mais uma coluna com fuso — sempre horário de Porto Velho,
  // igual ao resto do sistema, ver lib/format.ts#formatHoraPortoVelho.
  hora               String?
  feito              Boolean          @default(false)
  notas              String?
  // Cancelamento do compromisso (Fase Marketing/Agenda, 16/08/2026) —
  // pedido do usuário: "se for cancelado tanto pelo corretor quanto pelo
  // marketing precisamos informar o porque foi cancelado". Não apaga a
  // atividade (fica visível no calendário/OM com o motivo, só marcada) —
  // reagendar (confirmarSolicitacaoAgendaAction/reagendarSolicitacaoAgendaAction)
  // limpa esses 4 campos de volta pra null/false na mesma atividade.
  cancelado          Boolean          @default(false)
  cancelado_motivo   String?
  // "corretor" ou "marketing" — quem cancelou, pro outro lado saber de onde
  // veio (ex.: corretor abre a Agenda e vê "cancelado pelo marketing: ...").
  cancelado_por_tipo String?
  cancelado_em       DateTime?        @db.Timestamptz(6)
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  marketing_ordens   marketing_ordens @relation(fields: [marketing_ordem_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([marketing_ordem_id], map: "idx_marketing_atividades_ordem")
  @@index([data], map: "idx_marketing_atividades_data")
}

model marketing_notas {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  marketing_ordem_id String           @db.Uuid
  texto              String
  criado_em          DateTime         @default(now()) @db.Timestamptz(6)
  marketing_ordens   marketing_ordens @relation(fields: [marketing_ordem_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([marketing_ordem_id], map: "idx_marketing_notas_ordem")
}

model marketing_checklist_itens {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  marketing_ordem_id String           @db.Uuid
  label              String
  done               Boolean          @default(false)
  ordem              Int              @default(0) @db.SmallInt
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  marketing_ordens   marketing_ordens @relation(fields: [marketing_ordem_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([marketing_ordem_id], map: "idx_marketing_checklist_ordem")
}

/// Pedido do corretor pela aba "Agenda" do portal — sugere data/horário pra
/// um setor (só "marketing" selecionável por enquanto; campo já genérico pra
/// ligar outros setores depois sem mudar o schema). Quando o setor responde
/// e confirma, normalmente vira uma marketing_ordens (marketing_ordem_id
/// preenchido) — o pedido do corretor "é" o agendamento, ele não precisa
/// reagendar em outro lugar. visto_pelo_corretor controla a notificação
/// dentro do portal (fica false assim que alguém responde, volta a true
/// quando o corretor abre a Agenda).
model solicitacoes_agenda {
  id                          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parceiro_id                 String            @db.Uuid
  setor                       String            @default("marketing")
  titulo                      String
  descricao                   String?
  tipo                        String?
  data_hora_sugerida          DateTime          @db.Timestamptz(6)
  status                      String            @default("pendente")
  resposta_texto              String?
  data_hora_confirmada        DateTime?         @db.Timestamptz(6)
  respondido_por_parceiro_id  String?           @db.Uuid
  respondido_em               DateTime?         @db.Timestamptz(6)
  visto_pelo_corretor         Boolean           @default(true)
  marketing_ordem_id          String?           @db.Uuid
  // Imóvel do próprio corretor (parceiro_id = imoveis.parceiro_id) que ele
  // escolheu ao pedir a atividade — "cadastro inteligente" da OM,
  // 09/08/2026. Propagado pra marketing_ordens.imovel_id quando o pedido é
  // confirmado (confirmarSolicitacaoAgendaAction).
  imovel_id                   String?           @db.Uuid
  // Cancelamento (Fase Marketing/Agenda, 16/08/2026) — mesma ideia de
  // marketing_atividades acima, só que aqui é o PEDIDO em si (o "status"
  // ganha o valor "cancelada" além de pendente/confirmada/recusada já
  // existentes). Ver cancelarSolicitacaoAgendaAction (marketing) e
  // cancelarSolicitacaoAgendaCorretorAction (portal) em cada lado.
  cancelado_motivo             String?
  cancelado_por_tipo           String?
  cancelado_em                 DateTime?         @db.Timestamptz(6)
  excluido                    Boolean           @default(false)
  created_at                  DateTime          @default(now()) @db.Timestamptz(6)
  marketing_ordens            marketing_ordens? @relation(fields: [marketing_ordem_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  imoveis                     imoveis?          @relation(fields: [imovel_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parceiros_solicitacoes_agenda_parceiro_idToparceiros                 parceiros  @relation("solicitacoes_agenda_parceiro_idToparceiros", fields: [parceiro_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parceiros_solicitacoes_agenda_respondido_por_parceiro_idToparceiros  parceiros? @relation("solicitacoes_agenda_respondido_por_parceiro_idToparceiros", fields: [respondido_por_parceiro_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([parceiro_id], map: "idx_solicitacoes_agenda_parceiro")
  @@index([status], map: "idx_solicitacoes_agenda_status")
  @@index([imovel_id], map: "idx_solicitacoes_agenda_imovel")
}

// ====================================================================
// Eventos — pedido do usuário, 10/08/2026 ("gerenciador de evento [...]
// eventos publicados [...] pode ser recorrente [...] Evento público,
// fechado a administrativo, fechado a corretores ou interno"). Módulo novo,
// entregue em fases: Fase 1 é só o cadastro completo (este model) + tela
// "Eventos publicados"; calendário (admin/portal), página pública e mural
// do corretor entram na Fase 2, reaproveitando este mesmo model.
//
// `recorrencia`/`visibilidade`/`tipo` são texto livre validado em TS (ver
// lib/eventos/opcoes.ts), mesmo padrão de todo o resto do sistema — o
// schema não usa enum em lugar nenhum. `data_inicio` é sempre a primeira
// ocorrência; pra um evento recorrente, as ocorrências seguintes são
// calculadas em memória a partir de recorrencia/recorrencia_ate (não ficam
// materializadas em linhas próprias) — ver lib/eventos/ocorrencias.ts.
// `pago`/`valor`/`tem_desconto`/`valor_desconto`/`desconto_prazo` — Fase 7,
// 14/08/2026: deixaram de ser só informativos. Usuário pediu pra
// "consolidar o pagamento dessa forma: sempre que algum evento criado e
// tiver pagamento, chamar essa geração de pix por enquanto e controle de
// pagamento manual" — ou seja, mesmo mecanismo do convidado (Pix estático
// via lib/eventos/pix.ts + eventos_confirmacoes.pago marcado à mão),
// aplicado também à equipe que confirma presença num evento pago. Ver
// pago_funcoes_isentas logo abaixo pra isenção por função.
model eventos {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_legado               String?                @unique
  nome                    String
  tipo                    String?
  descricao               String?
  local                   String?
  imagem_url              String?
  data_inicio             DateTime               @db.Date
  // Só usado quando recorrencia != "Nenhuma" — data até quando o evento se
  // repete (ex.: "toda sexta até 20/12/2026"). Sem isso, um evento recorrente
  // nunca teria fim.
  recorrencia_ate         DateTime?              @db.Date
  horario_inicio          String?
  horario_fim             String?
  recorrencia             String                 @default("Nenhuma")
  visibilidade            String                 @default("Publico")
  // Mesmo campo/mesma ideia de publicacoes_site.portal_corretor — mostra
  // também no mural/perfil do corretor dentro do Portal, além da área
  // pública (quando visibilidade permitir).
  portal_corretor         Boolean                @default(false)
  ativo                   Boolean                @default(true)
  // Publicação agendada (Fase 2 do pedido do usuário: "agendamento das
  // datas da publicação") — evento só aparece nas áreas públicas/portal
  // quando publicado_em <= agora, mesmo com ativo = true.
  publicado_em            DateTime               @default(now()) @db.Timestamptz(6)
  pago                    Boolean                @default(false)
  valor                   Decimal?               @db.Decimal(10, 2)
  tem_desconto            Boolean                @default(false)
  valor_desconto          Decimal?               @db.Decimal(10, 2)
  desconto_prazo          DateTime?              @db.Date
  // Cobrança por convidado (Fase 6, pedido do usuário 12/08/2026: "quero um
  // pagamento específico para convidados... marcar que tem convidado e
  // cobrar por cabeça, criança até 14 anos não paga"). Separado do
  // valor/tem_desconto acima — aquele é o valor do evento em si (ex.: um
  // curso pago); esse é só pra quem se inscreve como convidado externo pelo
  // Formulário de inscrição (ver eventos_inscricoes.idade). Mesmo espírito
  // "só informativo" do resto — sem cobrança automática (Mercado Pago fica
  // pra outra etapa), só calcula quanto cada convidado deve pro admin
  // controlar o pagamento por fora e marcar manualmente (eventos_inscricoes.
  // pago). convidado_idade_gratis_ate default 14 (regra pedida), mas
  // editável por evento — não é o desconto por antecedência (esse é etário).
  cobra_convidado            Boolean               @default(false)
  valor_convidado            Decimal?              @db.Decimal(10, 2)
  convidado_idade_gratis_ate Int?                  @default(14)
  // Isenção de pagamento por função (Fase 7, 14/08/2026 — usuário perguntou
  // "na hora do pagamento, pode ter isentar? aí ter administrativo,
  // corretor, corretor estagiario" ao consolidar que evento.pago passa a
  // usar o mesmo Pix estático + controle manual do convidado, não mais só
  // informativo). Lista de funções que NÃO pagam esse evento (as demais
  // funções elegíveis pagam) — mesmo espírito de convidado_idade_gratis_ate,
  // só que por função em vez de idade. Pode ser sobrescrito por pessoa
  // específica em eventos_confirmacoes.pago_isento (pedido: "os dois
  // juntos" — regra geral por função + exceção pontual por pessoa). Só faz
  // sentido quando pago = true.
  pago_funcoes_isentas       String[]              @default([])
  organizador_parceiro_id String?                @db.Uuid
  excluido                Boolean                @default(false)
  // Fase 3 (pedido do usuário, 10/08/2026): "Formulário básico"/"Formulário
  // completo" — inscrição pública de convidado externo (sem login), na
  // página pública do evento. null = nenhum formulário ativo. Ver
  // lib/eventos/opcoes.ts#FORMULARIO_INSCRICAO_OPCOES e eventos_inscricoes.
  formulario_inscricao    String?
  // "Formulário interno" — quando true, a tela de confirmação de presença no
  // Portal (app/portal/eventos) ganha os campos extras (leva convidado,
  // quantas pessoas, observações) além de confirmar/recusar — ver
  // eventos_confirmacoes.leva_convidado/quantidade_pessoas/observacoes.
  formulario_interno      Boolean                @default(false)
  // Lembretes no sino (Fase 4, pedido do usuário 10/08/2026): "quantas vezes
  // eu quiser" — lista livre de "dias antes" (ex.: [5, 2]). Só faz sentido
  // pra evento com público definido (visibilidade != "Publico" — Público não
  // tem lista de destinatários pra avisar); a UI só mostra esse campo nesse
  // caso, mas o array vazio já resolve sozinho pros eventos públicos (sem
  // lembrete configurado, nunca aparece nada no sino). Ver
  // lib/notificacoes.ts.
  lembretes_dias_antes    Int[]                  @default([])
  created_at              DateTime               @default(now()) @db.Timestamptz(6)
  updated_at              DateTime               @default(now()) @db.Timestamptz(6)
  parceiros               parceiros?             @relation(fields: [organizador_parceiro_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  eventos_confirmacoes    eventos_confirmacoes[]
  eventos_inscricoes      eventos_inscricoes[]
  eventos_atas_geradas    eventos_atas_geradas[]

  @@index([ativo, data_inicio], map: "idx_eventos_ativo")
  @@index([visibilidade, ativo], map: "idx_eventos_visibilidade")
  @@index([portal_corretor, ativo], map: "idx_eventos_portal")
}

// Controle de presença/ausência por evento (pedido do usuário, 10/08/2026)
// — um registro por parceiro elegível (função permitida pela visibilidade
// do evento), criado sob demanda quando o corretor/administrativo abre o
// evento no Portal pela primeira vez (não em massa na criação do evento).
// status: "Pendente" | "Confirmado" | "Recusado". Tela de confirmação fica
// pra Fase 2, junto com o resto da integração no Portal.
model eventos_confirmacoes {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evento_id     String    @db.Uuid
  parceiro_id   String    @db.Uuid
  status        String    @default("Pendente")
  // "Formulário interno" (Fase 3, pedido do usuário 10/08/2026) — só
  // preenchido quando eventos.formulario_interno = true e o parceiro
  // confirma presença; leva_convidado null enquanto não respondido (mesmo
  // espírito de status "Pendente": ausência de resposta, não "não vai levar").
  leva_convidado      Boolean?
  quantidade_pessoas  Int?
  observacoes         String?
  // Controle de pagamento do evento pago (Fase 7, 14/08/2026) — mesmo
  // espírito "só controle manual" de eventos_inscricoes.pago (Pix estático
  // + admin marca por fora, sem gateway ainda). pago_isento é o override
  // POR PESSOA da regra geral em eventos.pago_funcoes_isentas: null segue a
  // regra da função dela; true força isento mesmo se a função normalmente
  // paga; false força pagar mesmo se a função é isenta. Ver
  // lib/eventos/opcoes.ts#confirmacaoIsenta.
  pago                Boolean   @default(false)
  pago_isento         Boolean?
  // Fase 5 (pedido do usuário, 10/08/2026: "quando um evento se repete, a
  // confirmação vai aparecer pra todos [de novo, a cada ocorrência], né?").
  // Antes disso a confirmação era UMA por (evento, parceiro) pra sempre —
  // pra evento recorrente (Semanal etc.) isso estava errado: confirmar a
  // reunião desta semana deixava "Confirmado" cravado até alguém trocar de
  // novo, mesmo nas semanas seguintes. Agora cada ocorrência tem sua própria
  // linha (evento_id + parceiro_id + ocorrencia_data), calculada com a mesma
  // proximaOcorrencia() já usada pra decidir o que aparece na lista do
  // Portal — assim a pergunta "vai / não vai" volta a ficar em aberto pra
  // cada nova ocorrência. Nullable só pelas linhas criadas ANTES dessa
  // mudança (evento único "Nenhuma" sempre teve uma ocorrência só, então não
  // muda nada pra esses; só os recorrentes que já tinham confirmação
  // resetam uma vez, o que é o comportamento certo aqui).
  ocorrencia_data DateTime? @db.Date
  respondido_em DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  eventos       eventos   @relation(fields: [evento_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parceiros     parceiros @relation(fields: [parceiro_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([evento_id, parceiro_id, ocorrencia_data])
  @@index([parceiro_id], map: "idx_eventos_confirmacoes_parceiro")
}

// Respostas do "Formulário básico"/"Formulário completo" (Fase 3, pedido do
// usuário 10/08/2026) — inscrição de convidado externo (sem login), aberta
// na página pública do evento quando eventos.formulario_inscricao != null.
// tipo_formulario grava qual dos dois foi respondido (o completo pede mais
// campos); os campos exclusivos do completo (endereco/profissao/
// especialidade) ficam NULL numa resposta do básico.
model eventos_inscricoes {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evento_id        String    @db.Uuid
  tipo_formulario  String
  nome             String
  // Fase 6 (12/08/2026): ficaram opcionais — quando quem cadastra é um
  // parceiro da equipe reconhecido pelo e-mail (ver
  // verificarConvidadoEmailAction/adicionarConvidadoEquipeAction em
  // app/evento/[id]/actions.ts) adicionando um convidado que não tem
  // contato próprio (ex.: filho pequeno), não tem o que preencher aqui.
  // Continuam preenchidos normalmente no fluxo de convidado externo
  // (inscreverEventoAction).
  email            String?
  telefone         String?
  endereco         String?
  profissao        String?
  especialidade    String?
  // "Quem convidou" — parceiro (Administrativo, Corretor ou Corretor
  // Estagiário) escolhido pelo convidado numa lista, não texto livre (ver
  // lib/eventos/opcoes.ts#funcoesPermitidas, mesma lista de funções já usada
  // na visibilidade do evento).
  convidado_por_id String?   @db.Uuid
  // Idade do convidado (Fase 6, 12/08/2026) — só pedida no formulário
  // quando eventos.cobra_convidado = true (ver InscricaoEventoForm). Usada
  // só pra decidir se paga ou é grátis (idade <= eventos.
  // convidado_idade_gratis_ate); não guarda data de nascimento porque o
  // formulário público é rápido de preencher, idade em anos já resolve.
  // Null nos eventos sem cobrança de convidado (o campo nem aparece).
  idade            Int?
  // Controle manual de pagamento (mesmo espírito "só informativo" do valor
  // geral do evento, ver eventos.cobra_convidado) — admin marca aqui depois
  // que o convidado paga por fora (Pix, dinheiro etc.).
  pago             Boolean   @default(false)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  eventos          eventos   @relation(fields: [evento_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parceiros        parceiros? @relation(fields: [convidado_por_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([evento_id], map: "idx_eventos_inscricoes_evento")
}

// Log de geração da Ata de Reunião (Fase 3, pedido do usuário 10/08/2026:
// "gerador de ata para que o responsável faça no dia do evento"). Só
// registra QUE a ata foi gerada (quem, quando) — o conteúdo preenchido
// (seções/itens/presentes) não fica salvo no sistema, só no .docx baixado
// na hora, por decisão explícita do usuário.
model eventos_atas_geradas {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evento_id              String    @db.Uuid
  gerado_por_parceiro_id String    @db.Uuid
  gerado_em              DateTime  @default(now()) @db.Timestamptz(6)
  eventos                eventos   @relation(fields: [evento_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parceiros              parceiros @relation(fields: [gerado_por_parceiro_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([evento_id], map: "idx_eventos_atas_evento")
}
