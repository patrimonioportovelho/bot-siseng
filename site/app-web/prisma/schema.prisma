/// Módulo Marketing (Kanban) — pedido do usuário em 09/08/2026, baseado no
/// Manual Operacional de Marketing (Método IMPACTO). Mesmo padrão de
/// gestoes/manutencoes: tabela principal com "coluna" (etapa do quadro),
/// soft-delete via "excluido", e três tabelas satélite (checklist, notas,
/// atividades). marketing_atividades entra como 3ª fonte do calendário
/// compartilhado já existente (app/manutencao/calendario, hoje só
/// manutencao_atividades + gestao_atividades) — é assim que "todos os
/// calendários ficam ligados": não são calendários sincronizados, é o MESMO
/// calendário lendo de mais uma tabela.
model marketing_ordens {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Numeração automática OM-0001, OM-0002... (mesmo mecanismo de AVL-0001 em
  // avaliacoes — ver lib/marketing/id-legado.ts).
  id_legado                String?   @unique
  titulo                   String
  // Corretor que pediu a demanda (pode ser nulo pra demanda institucional,
  // sem solicitante — ex.: campanha da própria imobiliária).
  solicitante_parceiro_id  String?   @db.Uuid
  tipo                     String?
  // Os 5 modelos de briefing do Manual (venda, locação, empreendimento,
  // autoridade do corretor, evento institucional) têm campos bem diferentes
  // entre si — em vez de dezenas de colunas quase sempre vazias, guarda o
  // tipo escolhido + os campos daquele tipo num JSON (ver
  // lib/marketing/opcoes.ts pros templates). A tela renderiza o formulário
  // certo a partir de briefing_tipo.
  briefing_tipo            String?
  briefing_dados           Json?
  // Regra de ouro do Manual: "o agendamento reserva o horário; o briefing
  // autoriza a produção" — só true quando todos os campos obrigatórios
  // daquele tipo de briefing estiverem preenchidos (checado na Server Action,
  // não é só um campo solto).
  briefing_completo        Boolean   @default(false)
  objetivo                 String?
  // Campos que espelham o "Modelo de Ordem de Marketing" do Manual IMPACTO
  // (workspace Notion que o usuário trouxe em 09/08/2026) — público-alvo da
  // peça, empreendimento (texto livre por enquanto — sem cadastro à parte,
  // decisão do usuário), canal de publicação.
  publico                  String?
  empreendimento           String?
  // Cadastro completo opcional (Fase 5, 09/08/2026) — quando existe, é a
  // fonte de verdade pra exibição; "empreendimento" (texto livre, acima)
  // continua servindo pra quem não tem cadastro, sem quebrar Ordens antigas.
  empreendimento_id        String?   @db.Uuid
  // Imóvel cadastrado vinculado (opcional) — "cadastro inteligente" da OM,
  // 09/08/2026. Só puxa dados existentes (endereco/valor_venda) pra
  // preencher o briefing sozinho; não cria imóvel novo por aqui (isso já
  // existe nos fluxos de Gestão/Administração do portal — ver
  // app/portal/gestao/actions.ts). Vem preenchido automaticamente quando a
  // Ordem nasce de um pedido da Agenda que já linkou um imóvel
  // (confirmarSolicitacaoAgendaAction propaga de solicitacoes_agenda).
  imovel_id                String?   @db.Uuid
  canal                    String?
  prioridade               String    @default("Normal")
  coluna                   String    @default("recebido")
  data_captacao            DateTime? @db.Timestamptz(6)
  prazo_roteiro            DateTime? @db.Date
  prazo_entrega            DateTime? @db.Date
  data_publicacao          DateTime? @db.Date
  // Quem precisa agir agora — qualquer Parceiro função Administrativo e
  // Ativo (regra do usuário, aplicada na consulta que popula o <select>, não
  // trava por permissão no card em si).
  responsavel_atual_id     String?   @db.Uuid
  // Quem aprova o material antes de publicar — distinto do responsável
  // atual (que pode ser quem está produzindo). Mesma regra do usuário:
  // só Parceiro Administrativo + Ativo (lib/parceiros/administrativos.ts).
  responsavel_aprovacao_id String?   @db.Uuid
  bloqueio                 String?
  link_arquivos            String?
  aprovacao_status         String?
  // Métricas finais (alcance, directs, leads, visitas) — registro manual, o
  // sistema não tem integração com Instagram/Meta.
  resultados               Json?
  resultados_texto         String?
  excluido                 Boolean   @default(false)
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime  @default(now()) @db.Timestamptz(6)
  // Quando a Ordem entrou na etapa (coluna) atual — só mexido em
  // moverColunaAction, nunca em atualizarOrdemAction/salvarBriefingAction.
  // É a base do SLA de prazo (Fase 4, 09/08/2026): editar um campo qualquer
  // da Ordem não pode "resetar o relógio" do atraso, senão o alerta nunca
  // dispara pra card que segue sendo mexido mas não avança de etapa.
  coluna_atualizada_em     DateTime? @default(now()) @db.Timestamptz(6)
  checklist_itens          marketing_checklist_itens[]
  atividades               marketing_atividades[]
  notas                    marketing_notas[]
  solicitacoes_agenda      solicitacoes_agenda[]
  producoes                marketing_producoes[]
  parceiros_marketing_ordens_solicitante_parceiro_idToparceiros parceiros? @relation("marketing_ordens_solicitante_parceiro_idToparceiros", fields: [solicitante_parceiro_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parceiros_marketing_ordens_responsavel_atual_idToparceiros    parceiros? @relation("marketing_ordens_responsavel_atual_idToparceiros", fields: [responsavel_atual_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parceiros_marketing_ordens_responsavel_aprovacao_idToparceiros parceiros? @relation("marketing_ordens_responsavel_aprovacao_idToparceiros", fields: [responsavel_aprovacao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  marketing_empreendimentos marketing_empreendimentos? @relation(fields: [empreendimento_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  imoveis                   imoveis?                   @relation(fields: [imovel_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([coluna], map: "idx_marketing_ordens_coluna")
  @@index([solicitante_parceiro_id], map: "idx_marketing_ordens_solicitante")
  @@index([excluido], map: "idx_marketing_ordens_excluido")
  @@index([imovel_id], map: "idx_marketing_ordens_imovel")
}

// Cadastro completo de Empreendimento (Fase 5a, 09/08/2026) — Notion
// "Empreendimentos". Opcional: uma Ordem pode continuar usando só o campo
// de texto livre (marketing_ordens.empreendimento) quando não há cadastro.
model marketing_empreendimentos {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                    String
  construtora             String?
  categoria               String?
  diferenciais            String?
  publico_alvo            String?
  faixa_preco             String?
  localizacao             String?
  data_lancamento         DateTime?          @db.Date
  cta_principal           String?
  objecoes_principais     String?
  promessa_central        String?
  link_materiais          String?
  responsavel_parceiro_id String?            @db.Uuid
  status                  String             @default("Ativo")
  excluido                Boolean            @default(false)
  created_at              DateTime           @default(now()) @db.Timestamptz(6)
  updated_at              DateTime           @default(now()) @db.Timestamptz(6)
  marketing_ordens        marketing_ordens[]
