/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model clientes {
  id                                                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_legado                                              String?       @unique
  pasta_url                                              String?
  data_cadastro                                          DateTime      @default(dbgenerated("CURRENT_DATE")) @db.Date
  parceiro_id                                            String?       @db.Uuid
  loja_id                                                String?       @db.Uuid
  status_cadastro                                        String?
  tipo_vinculo                                           String?
  tipo_cliente                                           String
  nome                                                   String
  sexo                                                   String?
  cpf                                                    String?
  cnpj                                                   String?
  rg                                                     String?
  expedicao                                              String?
  telefone                                               String?
  email                                                  String?
  estado_civil                                           String?
  // Só é perguntado (e só faz sentido) quando estado_civil é Solteiro,
  // Divorciado ou Separado Judicialmente — juridicamente essas pessoas podem
  // conviver em união estável sem isso aparecer no estado civil formal, e a
  // qualificação de documentos (lib/documentos/gerar.ts, qualificacaoTexto)
  // precisa declarar isso ("solteiro e declara não conviver em união
  // estável" / "...declara conviver em união estável"). NULL = pergunta
  // nunca foi respondida (cadastros antigos, ou estado civil que não pede).
  uniao_estavel                                          Boolean?
  // Vínculo de cônjuge — quando o corretor/administrativo confirma que um
  // segundo cliente adicionado (co-proprietário, comprador etc.) é cônjuge
  // do primeiro, os dois registros passam a apontar um pro outro aqui. Só
  // muda o TEXTO da qualificação em contratos (Compra e Venda/Locação/
  // Administração): em vez de dois parágrafos independentes juntados por
  // "e", os dois viram um bloco único ("Fulano e sua/seu cônjuge Fulana,
  // ambos..." — ver qualificacaoConjuntaTexto em lib/documentos/gerar.ts).
  // NÃO confundir com "participante" (outro proprietário sem vínculo
  // conjugal) — esse continua exatamente como já funciona hoje, sem marcar
  // nada aqui.
  conjuge_id                                             String?       @db.Uuid
  renda_bruta                                            Decimal?      @db.Decimal(12, 2)
  data_nascimento                                        DateTime?     @db.Date
  // Nome da mãe e do pai — pedidos no cadastro de pessoa física em todos os
  // pontos de entrada (central de Clientes e os formulários do portal do
  // corretor). Nenhum documento/contrato usa esses campos hoje; ficam
  // guardados pro cadastro completo.
  nome_mae                                               String?
  nome_pai                                               String?
  cat_profissao                                          String?
  tipo_servidor                                          String?
  profissao                                              String?
  // Endereço de pessoa física agora é dividido em campos de verdade (CEP com
  // busca automática, logradouro, número, complemento, bairro — mesmo padrão
  // já usado em imoveis: rua/n_predial/complemento/bairro/cidade_id/
  // estado_id). `endereco` deixa de ser digitado direto e passa a ser
  // concatenado automaticamente a partir desses campos no momento de salvar
  // (ver montarEnderecoCliente em app/clientes/actions.ts, mesmo padrão de
  // app/imoveis/actions.ts#montarEndereco) — mantido assim pra não quebrar
  // nada que já lê `endereco` (qualificação de documentos, listagens etc.).
  // Cadastros antigos (import de planilha) continuam com `endereco` livre e
  // os campos novos NULL até serem editados de novo.
  cep                                                     String?
  rua                                                     String?
  n_predial                                              String?
  complemento                                            String?
  bairro                                                  String?
  endereco                                               String?
  estado_id                                              String?       @db.Uuid
  cidade_id                                              String?       @db.Uuid
  observacao                                             String?
  banco_id                                               String?       @db.Uuid
  codigo_banco                                           String?
  agencia                                                String?
  conta                                                  String?
  tipo_conta                                             String?
  tipo_pix                                               String?
  pix                                                    String?
  // Usado no contrato de gestão (Elaboração de Contrato de Gestão, portal do
  // corretor) — clientes antigos ficam NULL e o sistema continua inferindo
  // brasileiro/brasileira pelo campo "sexo" nesse caso (ver qualificacaoTexto
  // em lib/documentos/gerar.ts).
  nacionalidade                                          String?
  created_at                                             DateTime      @default(now()) @db.Timestamptz(6)
  updated_at                                             DateTime      @default(now()) @db.Timestamptz(6)
  adm_imoveis                                            adm_imoveis[]
  andamentos                                             andamentos[]
  avaliacoes                                             avaliacoes[]
  bancos                                                 bancos?       @relation(fields: [banco_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cidades                                                cidades?      @relation(fields: [cidade_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clientes                                               clientes?     @relation("clientesToclientes", fields: [conjuge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_clientes                                         clientes[]    @relation("clientesToclientes")
  estados                                                estados?      @relation(fields: [estado_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lojas                                                  lojas?        @relation(fields: [loja_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parceiros                                              parceiros?    @relation(fields: [parceiro_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gestoes                                                gestoes[]
  propostas                                              propostas[]
  imoveis_proprietarios                                  imoveis_proprietarios[]
  avaliacoes_clientes                                    avaliacoes_clientes[]
  // Sócios de uma Pessoa Jurídica (este cliente é a PJ) e, do outro lado,
  // as PJs das quais este cliente (pessoa física) é sócio — ver comentário
  // completo no model clientes_socios.
  clientes_socios_pj                                     clientes_socios[] @relation("clientes_socios_pjToclientes")
  clientes_socios_socio                                  clientes_socios[] @relation("clientes_socios_socioToclientes")
  pagamentos                                             pagamentos[]
  transacoes_contrapartes                                transacoes_contrapartes[]
  transacoes_transacoes_cliente_contraparte_idToclientes transacoes[]  @relation("transacoes_cliente_contraparte_idToclientes")
  transacoes_transacoes_cliente_idToclientes             transacoes[]  @relation("transacoes_cliente_idToclientes")
  movimentacoes_interessado                              movimentacoes[] @relation("movimentacoes_cliente_interessado_idToclientes")
  movimentacoes_proprietario                             movimentacoes[] @relation("movimentacoes_cliente_proprietario_idToclientes")
  manutencoes                                             manutencoes[]

  @@index([conjuge_id], map: "idx_clientes_conjuge")
  @@index([loja_id], map: "idx_clientes_loja")
  @@index([nome], map: "idx_clientes_nome")
  @@index([parceiro_id], map: "idx_clientes_parceiro")
}

/// Sócio(s) de um cliente Pessoa Jurídica. Ao cadastrar uma PJ e "adicionar
/// sócio", o sistema NÃO guarda só um nome solto aqui — ele cria (ou
/// reaproveita, se já existir) um cliente de verdade com tipo_cliente
/// "Pessoa Física" pra essa pessoa (pode um dia virar cliente PF nosso por
/// conta própria) e só então grava o vínculo nesta tabela. `ordem` define a
/// sequência de exibição/assinatura quando há mais de um sócio — o primeiro
/// (ordem 0) é quem assina como representante legal da empresa nos
/// contratos (ver qualificacaoTexto/blocoAssinatura em
/// lib/documentos/gerar.ts).
model clientes_socios {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pj_cliente_id   String   @db.Uuid
  socio_cliente_id String  @db.Uuid
  ordem           Int      @default(0) @db.SmallInt
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  pj              clientes @relation("clientes_socios_pjToclientes", fields: [pj_cliente_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  socio           clientes @relation("clientes_socios_socioToclientes", fields: [socio_cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([pj_cliente_id, socio_cliente_id])
  @@index([pj_cliente_id], map: "idx_clientes_socios_pj")
  @@index([socio_cliente_id], map: "idx_clientes_socios_socio")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model condicoes_pagamento {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_legado          String?      @unique
  transacao_id       String       @db.Uuid
  tipo               String?
  valor              Decimal      @db.Decimal(14, 2)
  descricao          String?
  descricao_ia       String?
  forma_pagamento    String?
  parcelas           Int?         @db.SmallInt
  momento            String?
  data_pagamento     DateTime?    @db.Date
  // Comissionamento vinculado a este pagamento específico: marca se o
  // honorário (ou parte dele) é devido quando este pagamento acontece —
  // pedido do usuário pra não pagar o honorário inteiro em cada Recebimento
  // gerado, quando o negócio tem mais de uma condição (ex.: Entrada +
  // Parcelado + Entradas futuras). porc_comissao é a fatia do honorário
  // TOTAL da transação (não do valor desta condição) representada por essa
  // condição; desconto_comissao é um abatimento em R$ aplicado só nessa
  // fatia. A previsão de quando isso será pago usa a própria data_pagamento
  // acima (não duplica campo).
  gera_comissao      Boolean      @default(false)
  porc_comissao      Decimal?     @db.Decimal(6, 4)
  desconto_comissao  Decimal?     @db.Decimal(14, 2)
  created_at         DateTime     @default(now()) @db.Timestamptz(6)
  transacoes         transacoes   @relation(fields: [transacao_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pagamentos         pagamentos[]

  @@index([transacao_id], map: "idx_condicoes_pg_transacao")
}

