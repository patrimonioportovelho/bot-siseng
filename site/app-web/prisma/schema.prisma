/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model cidades {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome               String
  estado_id          String               @db.Uuid
  regiao             String?
  estados            estados              @relation(fields: [estado_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clientes           clientes[]
  contratos_corretor contratos_corretor[]
  imoveis            imoveis[]
  parceiros          parceiros[]

  @@unique([nome, estado_id])
  @@index([estado_id], map: "idx_cidades_estado")
